/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Remember to never publicly share your RELEASE keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks
# Exception: the debug keystore is checked in on purpose so every build
# (local and CI) signs debug APKs with the same key — otherwise every fresh
# CI runner generates its own random debug key and Android refuses to
# install the new APK over the previous one.
!app/debug.keystore
